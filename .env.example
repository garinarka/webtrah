APP_NAME=Webtrah
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://webtrah.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=family_tree_db
DB_USERNAME=family_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=null

# Error tracking (Sentry) — isi DSN asli cuma di .env lokal/production,
# jangan pernah commit DSN asli ke git meski bukan secret rahasia.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0

# Backup database & storage otomatis (lihat config/backup.php)
# BACKUP_DISK: 'local' dulu (hosting belum ditentukan). Nanti kalau
# sudah pilih cloud storage, ganti ke 's3' dan tambah kredensial
# AWS_* di bawah — tidak perlu ubah kode.
BACKUP_DISK=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log dulu buat lokal (email cuma nyangkut di laravel.log,
# tidak beneran terkirim — aman & cepat buat development).
#
# Production: pakai 'resend' (HTTP API, bukan SMTP) — SMTP port 587/465
# terbukti diblokir total di jaringan lokal, HTTP API lewat port 443
# hampir tidak pernah diblokir ISP manapun.
MAIL_MAILER=log
RESEND_KEY=
# Testing/awal: onboarding@resend.dev (bawaan Resend, langsung bisa
# dipakai tanpa setup domain). Production beneran (kirim ke user
# manapun): verifikasi domain sendiri dulu di dashboard Resend.
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
